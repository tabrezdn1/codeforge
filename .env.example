# --- Required: Google Cloud Project ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Required: Cloud Storage ---
GOOGLE_CLOUD_STORAGE_BUCKET=codeforge-artifacts-your-project-id

# --- Auto-populated by setup_environment.sh ---
RAG_CORPUS_NAME=
